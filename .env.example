# OpportunityOS — Environment Variables Template
# Copy this file to .env and fill in real values.
# SECURITY WARNING: NEVER commit .env itself or expose secret keys in client-side code!

# 1. External Listings Ingestion API
BRABBLE_API_KEY=brbl_your_64_hex_char_key_here

# 2. Supabase Cloud Database & Auth
# Obtained from: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
# Anon key: safe for browser client requests (used by /api/config for Google SSO)
SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Service role key: SERVER-SIDE ONLY. Bypasses RLS for sync upserts & admin tasks. NEVER EXPOSE TO CLIENT!
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# 3. Security & Automation Tokens
SECRET_KEY=generate_a_secure_random_64_byte_hex_string_here
CRON_SECRET=generate_a_secure_random_cron_secret_token_here

# 4. Administrator Permissions (comma-separated list of admin emails)
ADMIN_EMAILS=sumayyamulla30@gmail.com

